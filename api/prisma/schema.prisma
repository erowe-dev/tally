generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  auth0Id   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances      Balance[]
  expiryRecords ExpiryRecord[]
  trips         Trip[]
  preferences   UserPreference?
  savedSearches SavedSearch[]
  awardSearchRuns AwardSearchRun[]

  @@map("users")
}

model Balance {
  id        String   @id @default(cuid())
  userId    String
  cardId    String   // 'amex_mr', 'chase_ur', etc. — matches DataService card IDs
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@map("balances")
}

model ExpiryRecord {
  id               String   @id @default(cuid())
  userId           String
  cardId           String
  lastActivityDate String   // 'YYYY-MM-DD' — matches existing ExpiryService format exactly
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@map("expiry_records")
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  tripType    String   // 'flight' | 'hotel'
  origin      String?  // IATA code e.g. 'ORD'
  destination String?  // IATA code or city name
  cabin       String?  // 'economy' | 'premium' | 'business' | 'first'
  passengers  Int?
  nights      Int?
  hotelCat    String?  // 'budget' | 'mid' | 'luxury' | 'top'
  programName String   // e.g. 'ANA Mileage Club'
  ptsRequired Int
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("trips")
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  homeAirports      Json     @default("[]")
  preferredCabin    String?
  maxStops          Int?
  preferredPrograms Json     @default("[]")
  heldProgramIds    Json     @default("[]")
  hotelChains       Json     @default("[]")
  defaultTravelers  Int?
  dateFlexibility   String?
  pointValuationCpp Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

model SavedSearch {
  id                 String    @id @default(cuid())
  userId             String
  searchType         String    // 'flight' | 'hotel'
  originAirport      String?
  destinationAirport String?
  destinationText    String
  dateWindow         Json
  cabin              String?
  passengers         Int       @default(1)
  hotelIntent        Json?
  notes              String?
  lastRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, searchType])
  @@map("saved_searches")
}

model ProviderCache {
  id                String   @id @default(cuid())
  cacheKey          String   @unique
  provider          String
  searchType        String
  normalizedRequest Json
  response          Json
  source            String
  confidence        Float    @default(0)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([provider, searchType])
  @@index([expiresAt])
  @@map("provider_cache")
}

model AwardSearchRun {
  id                 String   @id @default(cuid())
  userId             String
  originAirport      String
  destinationAirport String
  cabin              String
  passengers         Int
  dateWindow         Json
  status             String
  sourcesAttempted   Json     @default("[]")
  message            String?
  createdAt          DateTime @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidates    AwardSearchCandidate[]
  verifications AwardLiveVerification[]

  @@index([userId, createdAt])
  @@index([originAirport, destinationAirport, cabin])
  @@map("award_search_runs")
}

model AwardSearchCandidate {
  id                 String   @id @default(cuid())
  runId              String
  source             String
  sourceKey          String?
  originAirport      String
  destinationAirport String
  departureDate      String
  returnDate         String?
  cabin              String
  program            String
  points             Int?
  taxesUsd           Float?
  seatCount          Int?
  bookingUrl         String?
  raw                Json
  discoveredAt       DateTime @default(now())
  expiresAt          DateTime?

  run           AwardSearchRun         @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verifications AwardLiveVerification[]

  @@index([runId])
  @@index([source, sourceKey])
  @@index([originAirport, destinationAirport, departureDate])
  @@map("award_search_candidates")
}

model AwardLiveVerification {
  id                 String   @id @default(cuid())
  runId              String
  candidateId        String?
  source             String
  verificationStatus String
  originAirport      String
  destinationAirport String
  departureDate      String
  returnDate         String?
  cabin              String
  program            String
  points             Int?
  taxesUsd           Float?
  seatCount          Int?
  bookingUrl         String?
  raw                Json
  checkedAt          DateTime @default(now())
  expiresAt          DateTime

  run       AwardSearchRun        @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidate AwardSearchCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([runId])
  @@index([candidateId])
  @@index([verificationStatus, expiresAt])
  @@index([originAirport, destinationAirport, departureDate])
  @@map("award_live_verifications")
}
